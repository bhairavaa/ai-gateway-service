# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- App ---
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database (SQLite today; swap DATABASE_URL to a postgresql+asyncpg:// URL later) ---
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db

# --- Redis (rate limiting store) ---
# localhost here is for running the app directly (uvicorn). docker-compose.yml overrides this
# to redis://redis:6379/0 (the container's service name) when running via `docker compose up`.
REDIS_URL=redis://localhost:6379/0

# --- Provider credentials (leave blank to disable a provider; the registry skips unconfigured ones) ---
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# Leave blank for real OpenAI (api.openai.com). Set to route the "openai" provider slot through
# an OpenAI-compatible backend instead — e.g. OpenRouter: https://openrouter.ai/api/v1
# (an OpenRouter key looks like "sk-or-v1-..." and will NOT work against api.openai.com directly —
# that mismatch is exactly what OPENAI_BASE_URL fixes. Also match OPENAI_DEFAULT_MODEL / the
# request's `model` field to whatever string that backend expects, e.g. "openai/gpt-4o-mini".)
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5

GOOGLE_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# localhost here is for running Ollama directly on your machine. docker-compose.yml overrides
# this to http://ollama:11434 if you add an `ollama` service to it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1

# --- Fallback chain: comma-separated provider names, tried in order when no per-request override is given ---
DEFAULT_FALLBACK_CHAIN=openai,anthropic,gemini

# --- Rate limiting (per API key) ---
RATE_LIMIT_REQUESTS_PER_WINDOW=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Provider HTTP calls ---
PROVIDER_REQUEST_TIMEOUT_SECONDS=30

# --- Auth ---
API_KEY_HEADER_NAME=X-API-Key

# --- CORS ---
# Comma-separated origins allowed to call this API from a browser. "*" (default) allows any
# origin — fine for local dev/demo. Lock this down for anything production-facing, e.g.:
# CORS_ALLOWED_ORIGINS=https://myapp.com,https://staging.myapp.com
CORS_ALLOWED_ORIGINS=*
